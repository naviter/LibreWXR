# librewxr.seeyou.cloud — production settings (h03 CT 115).
#
# Loaded by both systemd units AFTER /srv/librewxr/.env, so every value here
# wins over the box's .env. The box's .env only needs the secrets
# (LIBREWXR_EUMETSAT_KEY / LIBREWXR_EUMETSAT_SECRET); keep them out of git.
# scripts/deploy.sh ships this file with the checkout and restarts the units,
# so a change here takes effect on the next deploy — local or CI alike.
#
# Several upstream features are OFF on purpose, so an 8-core / 16 GB box keeps
# up. Read the notes before switching anything back on.

# ===== Deployment: MULTI mode =====
# One pipeline process fetches; N render-only workers serve tiles from
# the shared CACHE_DIR. RENDER_ONLY=1 is set in the render systemd unit,
# NOT here (the pipeline reads this same file and must not be render-only).
LIBREWXR_MODE=multi

# Shared cache dir - REQUIRED in multi mode. Pipeline writes memmaps +
# state.json here; render workers mmap the same files (1x data copy).
LIBREWXR_CACHE_DIR=/srv/data/cache

# ===== Networking (render workers bind this; pipeline ignores it) =====
LIBREWXR_HOST=0.0.0.0
LIBREWXR_PORT=8090
LIBREWXR_PUBLIC_URL=https://librewxr.seeyou.cloud

# ===== Coverage =====
LIBREWXR_ENABLED_REGIONS=ALL
LIBREWXR_SATELLITE_ENABLED=false

# ===== Render worker pool =====
# 8 cores: 6 render workers + 1 pipeline + nginx/OS headroom.
LIBREWXR_WORKERS=6
LIBREWXR_TILE_CACHE_MB=200

# ===== Rain + lightning only: upstream extras off (2026-08-06) =====
LIBREWXR_STORM_CELLS_ENABLED=false
LIBREWXR_MCP_ENABLED=false
LIBREWXR_ALERTS_ENABLED=false
LIBREWXR_ARROW_FLOW_ENABLED=false

# Warm render workers held 1635 MB of coord caches each at the default 512
# entries (6 workers > 16 GB RAM, memory monitor thrashing). 128 caps it
# to ~400 MB/worker; nginx caches tiles 1h so recompute is rare.
LIBREWXR_COORD_CACHE_SIZE=128

# Sources upstream added after 2026-08-12, both on by default. Off to keep the
# workload the box was tuned for; turn on deliberately and watch memory.
#   RRQPE  — NOAA global satellite rain rate, an always-on bottom tier fetched
#            regardless of ENABLED_REGIONS (~350 MB of frames).
#   PAGASA — Philippines radar, which ENABLED_REGIONS=ALL would pull in.
LIBREWXR_RRQPE_ENABLED=false
LIBREWXR_PAGASA_ENABLED=false

# Radar extrapolation forecast frames: not needed (past radar + lightning only).
# With arrow_flow also false this removes all optical-flow CPU per cycle and
# drops the IFS future-timestep budget (config auto-derives it from nowcast).
LIBREWXR_NOWCAST_ENABLED=false
